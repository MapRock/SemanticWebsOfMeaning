@prefix ex:   <https://example.org/iris/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/iris/ontology>
    a owl:Ontology ;
    rdfs:label "Iris KMeans clustering example" ;
    rdfs:comment "Core Iris ontology and machine-learning clustering results." .

ex:FloweringPlant
    a owl:Class ;
    rdfs:label "Flowering plant" .

ex:Iris
    a owl:Class ;
    rdfs:label "Iris" ;
    rdfs:subClassOf ex:FloweringPlant .

ex:MachineLearningModel
    a owl:Class ;
    rdfs:label "Machine learning model" ;
    rdfs:comment "A trained machine-learning model represented as a knowledge-graph resource." .

ex:MachineLearnedCluster
    a owl:Class ;
    rdfs:label "Machine learned cluster" ;
    rdfs:comment "A cluster result produced by a machine-learning clustering model." .

ex:generatedBy
    a owl:ObjectProperty ;
    rdfs:label "generated by" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range ex:MachineLearningModel .

ex:representsLearnedClass
    a owl:AnnotationProperty ;
    rdfs:label "represents learned class" .

ex:modelName
    a owl:DatatypeProperty ;
    rdfs:label "model name" ;
    rdfs:domain ex:MachineLearningModel ;
    rdfs:range xsd:string .

ex:modelFileUrl
    a owl:DatatypeProperty ;
    rdfs:label "model file URL" ;
    rdfs:domain ex:MachineLearningModel ;
    rdfs:range xsd:anyURI .

ex:clusterId
    a owl:DatatypeProperty ;
    rdfs:label "cluster id" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:integer .

ex:memberCount
    a owl:DatatypeProperty ;
    rdfs:label "member count" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:integer .

ex:dominantSpecies
    a owl:DatatypeProperty ;
    rdfs:label "dominant species" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:string .

ex:sepalLengthCentroid
    a owl:DatatypeProperty ;
    rdfs:label "sepal length centroid" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:decimal .

ex:sepalWidthCentroid
    a owl:DatatypeProperty ;
    rdfs:label "sepal width centroid" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:decimal .

ex:petalLengthCentroid
    a owl:DatatypeProperty ;
    rdfs:label "petal length centroid" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:decimal .

ex:petalWidthCentroid
    a owl:DatatypeProperty ;
    rdfs:label "petal width centroid" ;
    rdfs:domain ex:MachineLearnedCluster ;
    rdfs:range xsd:decimal .

ex:IrisKMeansModel
    a owl:NamedIndividual, ex:MachineLearningModel ;
    rdfs:label "Iris KMeans model" ;
    ex:modelName "KMeans Iris clustering model" ;
    ex:modelFileUrl "https://github.com/MapRock/SemanticWebsOfMeaning/blob/main/book_code/iris_kmeans_model.pkl"^^xsd:anyURI .

ex:IrisCluster_VersicolorLike
    a owl:Class ;
    rdfs:subClassOf ex:Iris ;
    rdfs:label "Versicolor-like Iris" ;
    rdfs:comment "An Iris category corresponding to KMeans cluster 0, whose dominant known species in the training data is versicolor." .

ex:IrisKMeansCluster_0
    a owl:NamedIndividual, ex:MachineLearnedCluster ;
    rdfs:label "Iris KMeans cluster 0 (Versicolor-like)" ;
    ex:generatedBy ex:IrisKMeansModel ;
    ex:representsLearnedClass ex:IrisCluster_VersicolorLike ;
    ex:clusterId "0"^^xsd:integer ;
    ex:memberCount "62"^^xsd:integer ;
    ex:dominantSpecies "versicolor" ;
    ex:sepalLengthCentroid "5.902"^^xsd:decimal ;
    ex:sepalWidthCentroid "2.748"^^xsd:decimal ;
    ex:petalLengthCentroid "4.394"^^xsd:decimal ;
    ex:petalWidthCentroid "1.434"^^xsd:decimal .

ex:IrisCluster_SetosaLike
    a owl:Class ;
    rdfs:subClassOf ex:Iris ;
    rdfs:label "Setosa-like Iris" ;
    rdfs:comment "An Iris category corresponding to KMeans cluster 1, whose dominant known species in the training data is setosa." .

ex:IrisKMeansCluster_1
    a owl:NamedIndividual, ex:MachineLearnedCluster ;
    rdfs:label "Iris KMeans cluster 1 (Setosa-like)" ;
    ex:generatedBy ex:IrisKMeansModel ;
    ex:representsLearnedClass ex:IrisCluster_SetosaLike ;
    ex:clusterId "1"^^xsd:integer ;
    ex:memberCount "50"^^xsd:integer ;
    ex:dominantSpecies "setosa" ;
    ex:sepalLengthCentroid "5.006"^^xsd:decimal ;
    ex:sepalWidthCentroid "3.428"^^xsd:decimal ;
    ex:petalLengthCentroid "1.462"^^xsd:decimal ;
    ex:petalWidthCentroid "0.246"^^xsd:decimal .

ex:IrisCluster_VirginicaLike
    a owl:Class ;
    rdfs:subClassOf ex:Iris ;
    rdfs:label "Virginica-like Iris" ;
    rdfs:comment "An Iris category corresponding to KMeans cluster 2, whose dominant known species in the training data is virginica." .

ex:IrisKMeansCluster_2
    a owl:NamedIndividual, ex:MachineLearnedCluster ;
    rdfs:label "Iris KMeans cluster 2 (Virginica-like)" ;
    ex:generatedBy ex:IrisKMeansModel ;
    ex:representsLearnedClass ex:IrisCluster_VirginicaLike ;
    ex:clusterId "2"^^xsd:integer ;
    ex:memberCount "38"^^xsd:integer ;
    ex:dominantSpecies "virginica" ;
    ex:sepalLengthCentroid "6.850"^^xsd:decimal ;
    ex:sepalWidthCentroid "3.074"^^xsd:decimal ;
    ex:petalLengthCentroid "5.742"^^xsd:decimal ;
    ex:petalWidthCentroid "2.071"^^xsd:decimal .

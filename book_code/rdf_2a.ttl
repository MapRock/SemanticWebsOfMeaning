@prefix : <http://www.timemolecules.org#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dbpedia: <http://dbpedia.org/resource/> .
@prefix wikidata: <http://www.wikidata.org/entity/> .
@base <http://www.timemolecules.org#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://dbpedia.org/ontology/manufacturer
dbo:manufacturer rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.timemolecules.org#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         owl:inverseOf :partOf .


###  http://www.timemolecules.org#partOf
:partOf rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://www.timemolecules.org#Bicycle
:Bicycle rdf:type owl:Class .


###  http://www.timemolecules.org#City
:City rdf:type owl:Class .


###  http://www.timemolecules.org#Dog
:Dog rdf:type owl:Class ;
     rdfs:subClassOf :Mammal .


###  http://www.timemolecules.org#ElectricCar
:ElectricCar rdf:type owl:Class ;
             rdfs:subClassOf wikidata:Q1420 .


###  http://www.timemolecules.org#Engine
:Engine rdf:type owl:Class .


###  http://www.timemolecules.org#Heart
:Heart rdf:type owl:Class .


###  http://www.timemolecules.org#HumanBody
:HumanBody rdf:type owl:Class .


###  http://www.timemolecules.org#Mammal
:Mammal rdf:type owl:Class .


###  http://www.timemolecules.org#Manufacturer
:Manufacturer rdf:type owl:Class .


###  http://www.timemolecules.org#Physicist
:Physicist rdf:type owl:Class ;
           rdfs:subClassOf :Scientist .


###  http://www.timemolecules.org#Scientist
:Scientist rdf:type owl:Class .


###  http://www.timemolecules.org#TeslaModelS
:TeslaModelS rdf:type owl:Class ;
             rdfs:subClassOf :ElectricCar ;
             dbo:manufacturer :TeslaInc .


###  http://www.timemolecules.org#Wheel
:Wheel rdf:type owl:Class .


###  http://www.wikidata.org/entity/Q1420
wikidata:Q1420 rdf:type owl:Class ;
               rdfs:label "Car"@en .


###  http://www.wikidata.org/entity/Q190578
wikidata:Q190578 rdf:type owl:Class ;
                 rdfs:subClassOf wikidata:Q1420 ;
                 rdfs:label "Sedan" .


###  http://www.wikidata.org/entity/Q463632
wikidata:Q463632 rdf:type owl:Class ;
                 rdfs:subClassOf wikidata:Q190578 ;
                 rdfs:label "HondaAccord" .


